<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>Qc20Capture</AssemblyName>
    <StartupObject>WorkerEntry</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Renishaw.Calibration.Ballbar.Api;Renishaw.Calibration.Ballbar;Renishaw.Calibration.Devices;Renishaw.Calibration;Renishaw.IO;Renishaw.IO.Bluetooth;Renishaw.IO.SimpleSensorInterface;Renishaw.Net;Microsoft.VisualStudio.Validation">
      <HintPath>$(TraceDirectory)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
